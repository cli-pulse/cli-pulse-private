"Check how much quota is remaining for a specific provider (Claude, Codex, Gemini, and more)." = "查看指定服务商（Claude、Codex、Gemini 等）的剩余配额。";
"Provider" = "服务商";
"Get ${provider} quota" = "获取 ${provider} 的配额";
"Get Status" = "获取状态";
"Provider Quota" = "服务商配额";
